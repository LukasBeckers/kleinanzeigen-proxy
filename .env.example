API_BASE_URL=http://host.docker.internal:8000
# Comma-separated upstreams for load balancing. Search requests failover when an
# upstream returns success with zero results (degraded scrape). Remove unhealthy
# hosts until fixed.
# API_BASE_URLS=http://host.docker.internal:8000,http://other-host:8001
DATABASE_URL=sqlite+aiosqlite:////data/proxy.db
IMAGE_STORAGE_PATH=/data/images
IMAGE_DOWNLOAD_CONCURRENCY=5
